{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Poom houses seed",
  "type": "object",
  "required": ["houses"],
  "properties": {
    "houses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name_ko", "name_en", "type", "gu", "dong", "dong_center", "location", "shared_m2", "households", "rooms"],
        "properties": {
          "id": { "type": "string" },
          "type": { "enum": ["mom", "dad"] },
          "dong_center": { "$ref": "#/definitions/latLng" },
          "location": { "$ref": "#/definitions/latLng" },
          "shared_m2": { "type": "number", "minimum": 0 },
          "households": { "type": "integer", "minimum": 1 },
          "move_out_cleaning_fee": { "type": "integer", "minimum": 0 },
          "pois": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["kind", "name_ko", "name_en", "location"],
              "properties": {
                "kind": { "enum": ["school_e", "school_m", "school_h", "daycare", "station", "pediatric", "mart"] },
                "location": { "$ref": "#/definitions/latLng" }
              }
            }
          },
          "rooms": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "product", "bedrooms", "private_m2", "deposit", "rent", "fee", "available_from", "status"],
              "properties": {
                "product": { "enum": ["PRD_ROOM_1", "PRD_ROOM_2", "PRD_ROOM_3", "PRD_ROOM_4"] },
                "bedrooms": { "type": "integer", "minimum": 1, "maximum": 4 },
                "private_m2": { "type": "number", "minimum": 1 },
                "deposit": { "type": "integer", "minimum": 0 },
                "rent": { "type": "integer", "minimum": 0 },
                "fee": { "type": "integer", "minimum": 0 },
                "available_from": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
                "status": { "enum": ["vacant", "held", "occupied"] }
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "latLng": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 }
  }
}
