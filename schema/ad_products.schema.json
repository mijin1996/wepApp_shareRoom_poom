{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Poom advertising products",
  "type": "object",
  "required": ["products"],
  "properties": {
    "products": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "for", "price", "days", "name_ko", "name_en", "desc_ko", "desc_en"],
        "properties": {
          "id": { "enum": ["AD_OWNER_30D", "AD_AGENT_MONTH", "AD_TOP_7D", "AD_LEAD"] },
          "for": { "enum": ["owner", "agent", "both"] },
          "price": { "type": "integer", "minimum": 0 },
          "days": { "type": "integer", "minimum": 0 },
          "name_ko": { "type": "string", "minLength": 1 },
          "name_en": { "type": "string" },
          "desc_ko": { "type": "string" },
          "desc_en": { "type": "string" }
        }
      }
    }
  }
}
